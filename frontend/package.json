{
  "name": "pathology-triage-dashboard",
  "productName": "Pathology Triage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:full": "cross-env E2E_FULL=1 playwright test",
    "test:desktop": "npm run desktop:compile && cross-env E2E_DESKTOP=1 playwright test e2e/desktop.spec.ts",
    "preview": "vite preview",
    "desktop:compile": "tsc -p tsconfig.electron.json && vite build --mode desktop",
    "desktop:dev": "tsc -p tsconfig.electron.json && node scripts/desktop-dev.mjs",
    "desktop:build": "npm run desktop:compile && electron-builder"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@tanstack/react-query": "^5.104.2",
    "i18next": "^26.4.4",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.16",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^6.4.3",
    "vitest": "^5.0.4"
  },
  "description": "Pathologist dashboard and desktop app for the offline AI pathology triage system",
  "main": "dist-electron/main.cjs",
  "author": "pinecone-studio team 7",
  "license": "MIT"
}
